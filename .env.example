# Copy to .env and fill in. Never commit .env.
# Note: no vector DB key needed -- LanceDB is embedded (data/lancedb/).

# Generation LLM, default provider (free tier: https://build.nvidia.com,
# key starts with "nvapi-"; no token cap, ~40 req/min)
NVIDIA_API_KEY=

# Alternative generation provider (free tier: https://console.groq.com;
# faster inference but 100K tokens/day). Switch via GENERATION_LLM=groq:<model>
GROQ_API_KEY=

# RAGAS judge LLM for eval runs (cents per run)
OPENAI_API_KEY=

# Optional: Cohere trial key for eval-side rerank parity experiments only.
# Never used by the deployed app (trial tier is non-production, 1k calls/mo).
COHERE_API_KEY=

# Serving LLM (eval-selected): Gemini via Google AI Studio free tier
# (https://aistudio.google.com). Used by GENERATION_LLM=gemini:<model>.
GOOGLE_API_KEY=

# Origins allowed to call the API cross-origin (deployed frontend + local dev).
# Comma-separated or JSON array. Defaults to localhost when unset.
# CORS_ALLOWED_ORIGINS=https://<app>.vercel.app,http://localhost:5173

# Optional: observability (traces -> Langfuse Cloud free tier, US region).
# Leave unset for a strict no-op (no exporter, no network). Keys are
# region-bound: cloud.langfuse.com (EU, default) vs us.cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
